{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/duel.html", "destination": "/duel", "permanent": false },
    { "source": "/index.html", "has": [{ "type": "query", "key": "room" }], "destination": "/jeo", "permanent": false },
    { "source": "/", "has": [{ "type": "query", "key": "room" }], "destination": "/jeo", "permanent": false }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
